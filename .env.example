# Global / Backend Settings
# NOTE: leave these unquoted - this file is also loaded via docker-compose's
# `env_file:`, which (unlike pydantic-settings' own .env loader) passes values
# through literally and does not strip surrounding quotes.
PROJECT_NAME=Enterprise Workforce Analytics
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Primary Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce_analytics

# JWT signing secret. Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (app refuses to start with the default) when ENVIRONMENT=production.
SECRET_KEY=placeholder_key_please_change_in_env_file_for_security

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
